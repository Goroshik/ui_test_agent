LM_STUDIO_BASE_URL=http://localhost:1234/v1
MONGO_URI=mongodb://localhost:27017/visual-bot
LM_STUDIO_API_KEY=lm-studio

# --- Model roles (model switching) ---
# Each phase loads its model, runs, then unloads it to free VRAM.
# Set MODEL_SWITCHING_ENABLED=false to disable load/unload calls (all models must already be loaded).
LM_STUDIO_PLANNER_MODEL=qwen/qwen3.5-9b   # planning phase: memory analysis + step generation
LM_STUDIO_MAIN_MODEL=qwen/qwen3-vl-4b     # main agent: browser actions (vision model)
LM_STUDIO_VALIDATOR_MODEL=qwen/qwen3.5-9b # post-run validation: checks task completion
# MODEL_SWITCHING_ENABLED=false            # set to false to skip load/unload API calls

LM_STUDIO_AUX_MODEL=qwen3.5-0.8b         # auxiliary model: loop/hang detection
# LM_STUDIO_MODEL=  # legacy: fallback if MAIN_MODEL not set
# PLANNER_ENABLED=false             # set to false to skip memory analysis + planning (pass task directly to agent)
# SCREENSHOTS_ENABLED=false         # set to false to skip capturing screenshots during main run
# SNAPSHOTS_ENABLED=false           # set to false to skip capturing accessibility snapshots during main run
# PAGE_MEMORY_ENABLED=false         # set to false to skip post-run page description writing to memory
# DOM_MEMORY_ENABLED=false          # set to false to skip post-run DOM structure writing to dom-memory
# SCREENSHOT_ANALYSIS_ENABLED=false # set to false to skip post-run visual diff against baselines
# SNAPSHOT_ANALYSIS_ENABLED=false   # set to false to skip post-run snapshot text diff against baselines
# VISION_MAX_WIDTH=512  # max image size (px) before sending to vision model, fit inside NxN (default: 512)
