# ─── Ollama (local) ───────────────────────────────────────────────────────────
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_API_KEY=ollama
MONGO_URI=mongodb://localhost:27017/visual-bot

# --- Model roles (Ollama model switching via keep_alive) ---
# Each phase loads its model (keep_alive=OLLAMA_KEEP_ALIVE), runs, then unloads
# (keep_alive=0). Set MODEL_SWITCHING_ENABLED=false to skip the load/unload calls.
#
# Leave any *_MODEL blank to auto-pick the currently loaded model from Ollama
# (`/api/ps`). Falls back to any installed model if nothing is loaded.
OLLAMA_PLANNER_MODEL=                     # planning phase: memory analysis + step generation
OLLAMA_MAIN_MODEL=                        # main agent: browser actions (vision model)
OLLAMA_VALIDATOR_MODEL=                   # post-run validation: checks task completion
# OLLAMA_KEEP_ALIVE=30m                   # how long Ollama keeps a model resident
# MODEL_SWITCHING_ENABLED=false           # skip explicit load/unload

OLLAMA_CODING_MODEL=qwen2.5-coder:14b     # (legacy) local fallback for code generation
OLLAMA_AUX_MODEL=qwen2.5:0.5b             # auxiliary: loop/hang detection
# OLLAMA_MODEL=                           # legacy fallback if MAIN_MODEL not set

# ─── OpenRouter (cloud) ───────────────────────────────────────────────────────
# Required when any *_PROVIDER below is set to "openrouter".
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_HTTP_REFERER=https://github.com/visual-bot
OPENROUTER_APP_TITLE=visual-bot
# Global default OpenRouter model (used when no role-specific *_MODEL is set):
OPENROUTER_MODEL=anthropic/claude-haiku-4.5

# ─── Provider routing by role ─────────────────────────────────────────────────
# Each role picks a provider: "ollama" (default) or "openrouter".
# `coding` defaults to openrouter; everything else to ollama.
#
# MAIN_PROVIDER=ollama           # browser execution (vision required → keep local)
# PLANNER_PROVIDER=ollama        # planner + memory analysis + task verification
# ANALYZER_PROVIDER=ollama       # snapshot/text compare + post-run pipeline
# CODING_PROVIDER=openrouter     # test/selector/fixture generation
#
# Per-role model overrides (take precedence over OLLAMA_* / OPENROUTER_MODEL):
# MAIN_MODEL=
# PLANNER_MODEL=
# ANALYZER_MODEL=anthropic/claude-haiku-4.5
# CODING_MODEL=anthropic/claude-haiku-4.5
# CODING_MAX_TOKENS=16000

# ─── Pipeline toggles ─────────────────────────────────────────────────────────
# PLANNER_ENABLED=false             # set to false to skip memory analysis + planning (pass task directly to agent)
# SCREENSHOTS_ENABLED=false         # set to false to skip capturing screenshots during main run
# SNAPSHOTS_ENABLED=false           # set to false to skip capturing accessibility snapshots during main run
# PAGE_MEMORY_ENABLED=false         # set to false to skip post-run page description writing to memory
# DOM_MEMORY_ENABLED=false          # set to false to skip post-run DOM structure writing to dom-memory
# SCREENSHOT_ANALYSIS_ENABLED=false # set to false to skip post-run visual diff against baselines
# SNAPSHOT_ANALYSIS_ENABLED=false   # set to false to skip post-run snapshot text diff against baselines
# VISION_MAX_WIDTH=512              # max image size (px) before sending to vision model, fit inside NxN
