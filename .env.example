# ─── OpenRouter (default provider) ────────────────────────────────────────────
# The bot talks to OpenRouter out of the box — no local runtime required.
# Only OPENROUTER_API_KEY is mandatory. Get one at https://openrouter.ai/keys
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_HTTP_REFERER=https://github.com/visual-bot
OPENROUTER_APP_TITLE=visual-bot

# Global default model for every role (cheapest DeepSeek on OpenRouter as of
# 2026-07-26: $0.09 / 1M input tokens, $0.18 / 1M output tokens, 1M context).
# Re-check https://openrouter.ai/deepseek before changing — DeepSeek reprices often.
OPENROUTER_MODEL=deepseek/deepseek-v4-flash

MONGO_URI=mongodb://localhost:27017/visual-bot

# ─── Provider routing by role ─────────────────────────────────────────────────
# Roles: main (browser execution), planner (memory analysis + planning),
#        analyzer (snapshot/screenshot compare, verification, pipeline),
#        coding (test/selector/fixture generation).
#
# Provider per role: "openrouter" (default) or "ollama".
# LLM_PROVIDER sets the default for every role; <ROLE>_PROVIDER overrides one.
#
# LLM_PROVIDER=ollama            # move everything back to a local Ollama
# MAIN_PROVIDER=ollama           # e.g. keep only browser execution local
# PLANNER_PROVIDER=openrouter
# ANALYZER_PROVIDER=openrouter
# CODING_PROVIDER=openrouter

# Per-role model overrides (take precedence over OPENROUTER_MODEL / OLLAMA_*):
#
# NOTE: deepseek/deepseek-v4-flash is TEXT-ONLY. The `main` and `analyzer` roles
# send screenshots, so either point them at a vision-capable model here, or turn
# the image paths off (SCREENSHOTS_ENABLED / SCREENSHOT_ANALYSIS_ENABLED /
# VERIFICATION_ENABLED below) and rely on ARIA snapshots instead.
# MAIN_MODEL=
# PLANNER_MODEL=
# ANALYZER_MODEL=
# CODING_MODEL=
# CODING_MAX_TOKENS=16000

# ─── Ollama (local, opt-in) ───────────────────────────────────────────────────
# Only used by roles whose provider is set to "ollama" above.
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_API_KEY=ollama

# Each local phase loads its model (keep_alive=OLLAMA_KEEP_ALIVE), runs, then
# unloads (keep_alive=0). Set MODEL_SWITCHING_ENABLED=false to skip load/unload.
# Swapping is skipped automatically when no role uses Ollama.
#
# Leave any *_MODEL blank to auto-pick the currently loaded model from Ollama
# (`/api/ps`). Falls back to any installed model if nothing is loaded.
OLLAMA_PLANNER_MODEL=                     # planning phase: memory analysis + step generation
OLLAMA_MAIN_MODEL=                        # main agent: browser actions (vision model)
OLLAMA_VALIDATOR_MODEL=                   # post-run validation: checks task completion
# OLLAMA_KEEP_ALIVE=30m                   # how long Ollama keeps a model resident
# MODEL_SWITCHING_ENABLED=false           # skip explicit load/unload

OLLAMA_CODING_MODEL=qwen2.5-coder:14b     # (legacy) local fallback for code generation
OLLAMA_AUX_MODEL=qwen2.5:0.5b             # auxiliary: loop/hang detection
# OLLAMA_MODEL=                           # legacy fallback if MAIN_MODEL not set

# ─── Pipeline toggles ─────────────────────────────────────────────────────────
# PLANNER_ENABLED=false             # set to false to skip memory analysis + planning (pass task directly to agent)
# VERIFICATION_ENABLED=false        # set to false to skip post-run task verification (needs a vision model)
# SCREENSHOTS_ENABLED=false         # set to false to skip capturing screenshots during main run
# SNAPSHOTS_ENABLED=false           # set to false to skip capturing accessibility snapshots during main run
# PAGE_MEMORY_ENABLED=false         # set to false to skip post-run page description writing to memory
# DOM_MEMORY_ENABLED=false          # set to false to skip post-run DOM structure writing to dom-memory
# SCREENSHOT_ANALYSIS_ENABLED=false # set to false to skip post-run visual diff against baselines
# SNAPSHOT_ANALYSIS_ENABLED=false   # set to false to skip post-run snapshot text diff against baselines
# VISION_MAX_WIDTH=512              # max image size (px) before sending to vision model, fit inside NxN
